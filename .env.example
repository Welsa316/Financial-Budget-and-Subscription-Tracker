# ---------------------------------------------------------------------------
# Finance dashboard configuration
#
# Copy to .env for local development. In production set these as Railway
# service variables — never commit real values.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# "development" locally, "production" on Railway. Production turns on HTTPS
# redirects, HSTS, and the Secure flag on the session cookie.
NODE_ENV=development

# Railway injects PORT automatically; only set this locally.
PORT=3000

# SQLite file location. Locally this defaults to ./data/finance.db.
# On Railway, attach a volume with mount path /data and set:
#   DB_PATH=/data/finance.db
DB_PATH=

# Zone used for pay-week boundaries, "this month", and the sync schedule.
# The container clock is UTC; this is what the app actually reasons in.
APP_TIMEZONE=America/Chicago


# --- Authentication --------------------------------------------------------

# argon2id hash of your dashboard password. Generate with:
#   npm run build && npm run hash-password
# Paste the whole $argon2id$... string. Unquoted in .env; single-quoted in a shell.
APP_PASSWORD_HASH=

# How long a session cookie stays valid. 30 days keeps your phone logged in.
SESSION_DAYS=30

# Login rate limit: attempts per window, per IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15


# --- Encryption ------------------------------------------------------------

# Base64-encoded 32-byte key. Encrypts the Teller access token at rest.
# Generate ONCE with:
#   npm run build && node dist/scripts/generate-key.js
# Rotating this invalidates the stored token and forces a bank re-link.
ENCRYPTION_KEY=


# --- Teller ----------------------------------------------------------------
# See README "Teller setup" for how to obtain each of these.

# From the Teller dashboard. Also passed to Teller Connect in the browser —
# this one is not a secret.
TELLER_APPLICATION_ID=

# "sandbox" (fake data, no cert needed), "development" (real banks, free tier,
# up to 100 live connections), or "production".
TELLER_ENVIRONMENT=development

# mTLS client certificate and private key, base64-encoded so they survive as
# single-line environment variables. Generate with:
#   base64 -i certificate.pem | tr -d '\n'
#   base64 -i private_key.pem  | tr -d '\n'
# These authenticate your server to Teller. Never commit them.
TELLER_CERT_B64=
TELLER_KEY_B64=

# Override only if Teller changes their API host.
TELLER_API_BASE=https://api.teller.io


# --- Sync ------------------------------------------------------------------

# Set to false to boot without the twice-daily scheduler (useful in tests).
SYNC_ENABLED=true
